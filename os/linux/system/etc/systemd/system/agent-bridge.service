[Unit]
Description=Telegram control plane for tmux agent sessions
Documentation=https://github.com/realdavidvega/dotfiles
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=black
Group=black
EnvironmentFile=/srv/services/agents/bridge.env
ExecStart=/usr/bin/python3 /srv/services/agents/bin/agent-bridge.py serve
Restart=always
RestartSec=5

# SIGTERM cannot interrupt an in-flight long poll, so the daemon exits once the
# current one returns. The poll is 25s, and systemd's 90s default was killing
# it with SIGKILL on every restart.
TimeoutStopSec=40

# The bridge talks to the tmux server over its socket in /tmp/tmux-1000, so a
# private /tmp would hide exactly the thing it exists to control.
PrivateTmp=false

NoNewPrivileges=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

# Outbound HTTPS long-poll only. Nothing listens.
IPAddressDeny=

[Install]
WantedBy=multi-user.target
