[Unit]
Description=Black System, the journal's Telegram transport
Documentation=https://github.com/realdavidvega/dotfiles
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=black
Group=black
EnvironmentFile=/srv/services/system/system.env
ExecStart=/usr/bin/python3 /srv/services/system/bin/black-system.py serve
Restart=always
RestartSec=5

# The poll is 15 seconds with a 30 second socket timeout.
TimeoutStopSec=40

NoNewPrivileges=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
