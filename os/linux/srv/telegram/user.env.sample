# The Telegram account telegram-user.py acts as, shared by agent-bridge.py and
# black-system.py to mute fresh topics and to clear topics, which a bot cannot.
#
# Lives at /srv/services/telegram/user.env, mode 0600, because the home is
# ecryptfs and a boot service cannot read it. It holds a login session, so the
# real file is never committed.

# From https://my.telegram.org, under API development tools.
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=

# Written, never printed, by:
#   /srv/services/telegram/venv/bin/python /srv/services/telegram/bin/telegram-user.py login
# Log in with your phone number. A bot token logs in a bot, which can do neither job.
TELEGRAM_USER_SESSION=
