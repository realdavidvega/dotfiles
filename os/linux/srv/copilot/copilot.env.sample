# Configuration for black-copilot.py, the journal copilot's Telegram transport.
#
# Copy to /srv/services/copilot/copilot.env, mode 0600, owned by the desktop
# user. It lives under /srv because the home is ecryptfs and a boot service
# cannot read it. This file holds a bot token and is never committed.

# BotFather token. One token can be long-polled by one service only, so this
# must not be the agent bridge's bot.
COPILOT_BOT_TOKEN=

# A private chat with the bot (a positive id) or a group (negative). Message
# the bot, then run: black-copilot.py discover
COPILOT_CHAT_ID=

# Telegram user ids allowed to write into the vault. Comma separated.
COPILOT_ALLOWED_USER_IDS=

# The staged journal-copilot scripts and the vault they write to.
COPILOT_SKILL_DIR=/srv/services/copilot/journal-copilot/scripts
BLACK_VAULT=/srv/sync/blackvault

# Update offset and which prompts were sent today.
COPILOT_STATE=/srv/services/copilot/copilot-state.json

# Claude model for /motivate and the Motivate button, the copilot's only model
# call. Empty means sonnet. Any name the Claude CLI's --model accepts works.
COPILOT_MOTIVATE_MODEL=sonnet

# Codex model used when Claude fails, or is skipped because the Claude usage
# cache shows a 5h or 7d window at its limit. Empty means Codex's own default,
# off means no fallback and the no-model pick instead.
COPILOT_MOTIVATE_FALLBACK=
