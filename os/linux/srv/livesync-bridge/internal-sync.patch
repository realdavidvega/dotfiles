diff --git a/main.ts b/main.ts
index bc1754a..48021b0 100644
--- a/main.ts
+++ b/main.ts
@@ -16,6 +16,16 @@ globalThis.addEventListener("unhandledrejection", (event) => {
     console.error("[LSB] Unhandled rejection (kept alive):", event.reason);
 });
 
+// chokidar attaches a Deno watcher to each file it sees. When the file is gone
+// by then (a git lock, a Syncthing or editor temp file), Deno throws NotFound
+// from a timer where no caller can catch it. The file no longer exists, so
+// there is nothing to watch: log it and keep running.
+globalThis.addEventListener("error", (event) => {
+    if (!(event.error instanceof Deno.errors.NotFound)) return;
+    event.preventDefault();
+    console.error("[LSB] Watched path vanished (kept alive):", event.error.message);
+});
+
 const KEY = "LSB_"
