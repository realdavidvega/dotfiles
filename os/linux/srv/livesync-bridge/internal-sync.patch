+Deno.test("PeerStorage applies includeInternal to filesystem paths", () => {
+    const config: PeerStorageConf = {
+        type: "storage",
+        name: `test-peer-${crypto.randomUUID()}`,
+        baseDir: "/vault",
+        scanOfflineChanges: false,
+        includeInternal: [
+            ".obsidian/plugins/**",
+            ".obsidian/app.json",
+        ],
+    };
+    const peer = new PeerStorage(config, async () => {});
+
+    assert(peer.shouldSyncPath("notes/example.md"), "ordinary vault files should sync");
+    assert(peer.shouldSyncPath(".obsidian/plugins/example/main.js"), "allowlisted internal files should sync");
+    assert(peer.shouldSyncPath(".obsidian/app.json"), "allowlisted internal files should support exact matches");
+    assert(!peer.shouldSyncPath(".obsidian/workspace.json"), "internal files outside the allowlist should not sync");
+    assert(!peer.shouldSyncPath(".git/config"), ".git should not sync");
+    assert(!peer.shouldSyncPath(".obsidian/plugins/obsidian-livesync/data.json"), "LiveSync connection settings should stay device-local");
+    assert(!peer.shouldSyncPath("folder/.secret"), "nested internal files should not sync");
+
+    assert(peer.shouldWatchPath(""), "the vault root must be watched");
+    assert(peer.shouldWatchPath("notes"), "ordinary folders must be watched");
+    assert(peer.shouldWatchPath(".obsidian"), "a folder holding allowlisted files must be watched");
+    assert(peer.shouldWatchPath(".obsidian/plugins/example"), "plugin folders must be watched");
+    assert(!peer.shouldWatchPath(".git"), ".git must not be watched");
+    assert(!peer.shouldWatchPath(".stversions"), "Syncthing versions must not be watched");
+    assert(!peer.shouldWatchPath(".syncthing.AGENTS.md.tmp"), "Syncthing temp files must not be watched");
+    assert(!peer.shouldWatchPath(".obsidian/.syncthing.workspace.json.tmp"), "temp files beside settings must not be watched");
+});
+
