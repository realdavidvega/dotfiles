# Configuration for agent-bridge.py, the Telegram control plane.
#
# Copy to /srv/services/agents/bridge.env, mode 0600, owned by the desktop
# user. It lives under /srv rather than in the home because the home is
# ecryptfs and a boot service cannot read it.
#
# This file holds a bot token. It is a sample in the repository and the real
# one is never committed.

# BotFather token. The same bot the vault already uses is fine.
AGENT_BRIDGE_BOT_TOKEN=

# The supergroup that has Topics enabled, NOT a private chat. Negative number,
# usually starting -100. Add the bot as an administrator with "Manage topics".
# Send /id to the bot in the group to have it report what it sees.
AGENT_BRIDGE_CHAT_ID=

# Telegram user ids permitted to drive a session. Anything typed into a pane
# runs on this machine, so this is the gate that matters. Comma separated.
AGENT_BRIDGE_ALLOWED_USER_IDS=

# tmux sessions the bridge may touch, as names or fnmatch patterns.
# Space or comma separated. An empty value allows nothing. The chat and user
# gates above are what keep strangers out, so * is reasonable on a machine
# used by one person. Names starting with @ are reserved for the Limits topic
# and never match.
AGENT_BRIDGE_SESSIONS=*

# Colon-separated roots whose panes /peek may render. A session elsewhere, such
# as a work repository, can still be driven, but its screen stays on the host.
# Unset means the personal defaults: ~/Workspace/repos/github,
# ~/Workspace/repos/external, /srv/sync/blackvault and the dotfiles checkout.
# AGENT_BRIDGE_CONTENT_ROOTS=

# Usage limits for Claude Code and Codex, posted to the Limits topic.
# AGENT_BRIDGE_LIMITS=on
# Warn at this percentage, or 0 to report only a reached limit and its reset.
# AGENT_BRIDGE_LIMIT_WARN=90

# Muting a fresh topic, /clear and the daily prune of week-old messages act as
# your own account, which a bot cannot. They use /srv/services/telegram, set up
# by the same restore step and configured in os/linux/srv/telegram/user.env.sample.
# Without it, topics start unmuted and nothing is deleted.

# Where the session-to-topic mapping and the update offset are kept.
AGENT_BRIDGE_STATE=/srv/services/agents/bridge-state.json
